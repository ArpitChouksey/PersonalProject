            "body": "swagger: \"2.0\"\n\ninfo:\n  title: simple-swagger-api\n  description: Minimal OpenAPI import test -- one path, one Lambda.\n  version: \"1.0\"\n\nhost: apigateway.amazonaws.com\nbasePath: /\nschemes:\n  - https\n\npaths:\n\n  /hello:\n\n    get:\n      summary: Say hello\n      responses:\n        \"200\":\n          description: OK\n      x-amazon-apigateway-integration:\n        type: aws_proxy\n        httpMethod: POST\n        uri: \"arn:aws:apigateway:us-west-2:lambda:path/2015-03-31/functions/arn:aws:lambda:us-west-2:211811255273:function:apigw-simple-hello/invocations\"\n        passthroughBehavior: when_no_match\n",
