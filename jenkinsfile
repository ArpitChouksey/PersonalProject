pipeline {
    agent any

    environment {
        REPO_NAME            = "PersonalProject"
        GIT_BRANCH           = "P2-MS-EKS-APPLICATION"
        SPRING_SERVICE_DIR   = "PersonalProject/Microservice/SpringBootMS/spring-service"
        PYTHON_SERVICE_DIR   = "PersonalProject/Microservice/DJangoMS/python-service"
        
        AWS_ACCOUNT_ID       = "211811255273"
        AWS_REGION           = "ap-south-1"
        ECR_REGISTRY         = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        ECR_REPO_NAME        = "eks-app-repo"
    }

    stages {
        stage('Clean & Checkout') {
            steps {
                deleteDir()
                sh "git clone -b ${GIT_BRANCH} https://github.com/ArpitChouksey/PersonalProject.git"
            }
        }

        stage('Install AWS CLI (ARM64)') {
            steps {
                sh '''
                    if [ ! -f "./bin/aws" ]; then
                        curl "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o "awscliv2.zip"
                        unzip -q -o awscliv2.zip
                        ./aws/install --install-dir $(pwd)/aws-cli-data --bin-dir $(pwd)/bin --update
                    fi
                    ./bin/aws --version
                '''
            }
        }

        stage('Setup Buildx') {
            steps {
                sh '''
                    # Install QEMU emulators for multi-platform support
                    docker run --privileged --rm tonistiigi/binfmt --install all
                    
                    # Create and use the builder
                    docker buildx create --name mybuilder --use --driver docker-container || true
                    
                    # Ensure the builder is started and ready
                    docker buildx inspect --bootstrap
                '''
            }
        }

        stage('Spring Boot Build') {
            steps {
                dir("${SPRING_SERVICE_DIR}") {
                    sh "chmod +x mvnw && ./mvnw clean package -DskipTests"
                }
            }
        }

        stage('Push Multi-Arch Images') {
            steps {
                // Fixed the ID here: added the 'r' to aws-ecr-creds
                withCredentials([usernamePassword(credentialsId: 'aws-ecr-creds', 
                                                 passwordVariable: 'AWS_SECRET_ACCESS_KEY', 
                                                 usernameVariable: 'AWS_ACCESS_KEY_ID')]) {
                    sh '''
                        export PATH=$PATH:$(pwd)/bin
                        export AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
                        export AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
                        
                        # Login to ECR
                        ./bin/aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}

                        # Build and Push Spring Image (Multi-Arch)
                        docker buildx build --platform linux/amd64,linux/arm64 \
                            -t ${ECR_REGISTRY}/${ECR_REPO_NAME}:spring-v2 \
                            ${SPRING_SERVICE_DIR} --push

                        # Build and Push Python Image (Multi-Arch)
                        docker buildx build --platform linux/amd64,linux/arm64 \
                            -t ${ECR_REGISTRY}/${ECR_REPO_NAME}:python-v2 \
                            ${PYTHON_SERVICE_DIR} --push
                    '''
                }
            }
        }
    }
}
